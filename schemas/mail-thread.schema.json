{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantareal.local/schemas/mail-thread.schema.json",
  "title": "Fantareal Mobile Chat Mail Thread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "threadId",
    "subject",
    "counterpartyId",
    "counterpartyName",
    "messages",
    "isRead",
    "source",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "threadId": {"type": "string", "pattern": "^mail_[A-Za-z0-9._-]{6,155}$"},
    "subject": {"type": "string", "minLength": 1, "maxLength": 120},
    "counterpartyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "counterpartyName": {"type": "string", "minLength": 1, "maxLength": 120},
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "direction",
          "authorId",
          "authorName",
          "content",
          "mood",
          "source",
          "createdAt"
        ],
        "properties": {
          "messageId": {"type": "string", "pattern": "^mailmsg_[A-Za-z0-9._-]{6,152}$"},
          "direction": {"enum": ["sent", "received"]},
          "authorId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
          "authorName": {"type": "string", "minLength": 1, "maxLength": 120},
          "content": {"type": "string", "minLength": 1, "maxLength": 2000},
          "mood": {"type": "string", "maxLength": 40},
          "source": {"enum": ["manual", "model", "import"]},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "isRead": {"type": "boolean"},
    "source": {"enum": ["manual", "model", "import"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
