{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantareal.local/schemas/mobile-chat/group.schema.json",
  "title": "Fantareal Mobile Chat Group",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groupId",
    "title",
    "description",
    "members",
    "replyCount",
    "allowRoleToRoleReply",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "groupId": {
      "type": "string",
      "pattern": "^group_[a-z0-9][a-z0-9_-]{5,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roleId", "displayName", "kind", "summary"],
        "properties": {
          "roleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": ["user", "character"]
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "replyCount": {
      "enum": [1, 2]
    },
    "allowRoleToRoleReply": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
