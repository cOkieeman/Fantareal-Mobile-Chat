{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantareal.local/schemas/prompt-profile.schema.json",
  "title": "Fantareal Mobile Chat Prompt Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "enabled", "instruction", "updatedAt"],
  "properties": {
    "scope": {"enum": ["diary", "calendar", "feed", "forum", "mail", "phone", "live", "assistant"]},
    "enabled": {"type": "boolean"},
    "instruction": {"type": "string", "maxLength": 4000},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
