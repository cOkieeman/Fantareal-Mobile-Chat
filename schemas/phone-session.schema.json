{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantareal.local/schemas/phone-session.schema.json",
  "title": "Fantareal Mobile Chat Phone Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "contactId", "contactName", "status", "endedBy", "lines", "source", "startedAt", "updatedAt", "endedAt"],
  "properties": {
    "sessionId": {"type": "string", "pattern": "^call_[A-Za-z0-9._-]{6,155}$"},
    "contactId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "contactName": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {"enum": ["ongoing", "ended", "missed"]},
    "endedBy": {"enum": ["", "user", "character"]},
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineId", "direction", "authorId", "authorName", "content", "mood", "source", "createdAt"],
        "properties": {
          "lineId": {"type": "string", "pattern": "^callline_[A-Za-z0-9._-]{6,151}$"},
          "direction": {"enum": ["sent", "received"]},
          "authorId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
          "authorName": {"type": "string", "minLength": 1, "maxLength": 120},
          "content": {"type": "string", "minLength": 1, "maxLength": 500},
          "mood": {"type": "string", "maxLength": 40},
          "source": {"enum": ["manual", "model", "import"]},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "source": {"enum": ["manual", "model", "import"]},
    "startedAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "endedAt": {"type": "string", "maxLength": 80}
  }
}
