{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantareal.local/schemas/forum-thread.schema.json",
  "title": "Fantareal Mobile Chat Forum Thread",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "threadId",
    "title",
    "body",
    "category",
    "authorId",
    "authorName",
    "replies",
    "source",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "threadId": {"type": "string", "pattern": "^thread_[A-Za-z0-9._-]{6,153}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "body": {"type": "string", "minLength": 1, "maxLength": 8000},
    "category": {"type": "string", "minLength": 1, "maxLength": 60},
    "authorId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "authorName": {"type": "string", "minLength": 1, "maxLength": 120},
    "replies": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "replyId",
          "content",
          "authorId",
          "authorName",
          "source",
          "createdAt"
        ],
        "properties": {
          "replyId": {"type": "string", "pattern": "^reply_[A-Za-z0-9._-]{6,154}$"},
          "content": {"type": "string", "minLength": 1, "maxLength": 2000},
          "authorId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
          "authorName": {"type": "string", "minLength": 1, "maxLength": 120},
          "source": {"enum": ["manual", "model", "import"]},
          "createdAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "source": {"enum": ["manual", "model", "import"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"}
  }
}
