{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantareal.dev/schemas/mobile-chat-fixture.schema.json",
  "title": "Fantareal Mobile Chat fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cardUid", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cardUid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "groups": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "title", "memberRoleIds", "messages"],
      "properties": {
        "groupId": { "$ref": "#/$defs/localId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "memberRoleIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "messages": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messageId", "authorRoleId", "content", "createdAt"],
      "properties": {
        "messageId": { "$ref": "#/$defs/localId" },
        "authorRoleId": { "$ref": "#/$defs/localId" },
        "content": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    }
  }
}
