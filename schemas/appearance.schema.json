{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantareal.local/schemas/mobile-chat/appearance.schema.json",
  "title": "Fantareal Mobile Chat Appearance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "preset", "tone", "background"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "preset": {
      "enum": ["modern", "social", "xianxia", "apocalypse"]
    },
    "tone": {
      "enum": ["midnight", "mist"]
    },
    "background": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/resourceRef" }
      ]
    }
  },
  "$defs": {
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "assetId", "alt"],
      "properties": {
        "packId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
