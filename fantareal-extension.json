{
  "schemaVersion": 1,
  "id": "com.fantareal.mobile-chat",
  "name": "小手机",
  "description": "角色社交与轻应用空间。MC4 提供按角色隔离的口袋群聊闭环。",
  "version": "0.4.0-dev.1",
  "publisher": "cOkieeman",
  "compatibility": {
    "hostApi": ">=1.2.0 <2.0.0"
  },
  "entrypoints": {
    "page": {
      "type": "web",
      "path": "web/index.html",
      "bridge": "fantareal.extension.v1"
    },
    "service": {
      "type": "python",
      "module": "fantareal_mobile_chat.service",
      "protocol": "jsonrpc-2.0-stdio",
      "lockfile": "uv.lock"
    }
  },
  "contributes": {
    "pages": [
      {
        "id": "mobile-chat",
        "title": "小手机",
        "description": "打开按角色隔离、使用 Host 受管模型的口袋群聊。",
        "icon": "message",
        "presentation": {
          "kind": "window",
          "defaultMode": "compact",
          "modes": [
            {
              "id": "compact",
              "width": 390,
              "height": 700,
              "minWidth": 360,
              "minHeight": 620,
              "maxWidth": 440,
              "maxHeight": 820
            },
            {
              "id": "expanded",
              "width": 760,
              "height": 720,
              "minWidth": 680,
              "minHeight": 620,
              "maxWidth": 960,
              "maxHeight": 860
            }
          ]
        },
        "launcher": {
          "surface": "applications",
          "order": 100
        }
      }
    ],
    "commands": [
      {
        "id": "mobile-chat.open",
        "title": "打开小手机",
        "handler": {
          "type": "page.open",
          "page": "mobile-chat"
        }
      }
    ]
  },
  "permissions": [
    "storage.data",
    "files.user-selected.directory-read",
    "character.context.read",
    "llm.generate"
  ]
}
